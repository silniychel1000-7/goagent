{
  "title": "Network Infrastructure Monitoring",
  "uid": "netmon-overview",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Host Availability",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "network_up", "legendFormat": "{{ target }}" }],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Uptime last hour (%)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "avg_over_time(network_up[1h]) * 100",
        "legendFormat": "{{ target }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "TCP services",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "targets": [{
        "expr": "tcp_up",
        "legendFormat": "{{ target }} / {{ service }}"
      }],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "network_latency_ms", "legendFormat": "{{ target }}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Packet Loss (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "network_packet_loss", "legendFormat": "{{ target }}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Jitter (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "network_jitter_ms", "legendFormat": "{{ target }}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "TCP RTT (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "tcp_rtt_ms",
        "legendFormat": "{{ target }} / {{ service }}"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 8,
      "title": "Interface RX bytes/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(iface_rx_bytes_total[1m]) * 8",
        "legendFormat": "{{ iface }}"
      }],
      "fieldConfig": { "defaults": { "unit": "bps" } }
    },
    {
      "id": 9,
      "title": "Interface TX bytes/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(iface_tx_bytes_total[1m]) * 8",
        "legendFormat": "{{ iface }}"
      }],
      "fieldConfig": { "defaults": { "unit": "bps" } }
    },
    {
      "id": 10,
      "title": "Interface errors + drops",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "rate(iface_rx_errors_total[5m])",
          "legendFormat": "{{ iface }} RX errors"
        },
        {
          "expr": "rate(iface_rx_drops_total[5m])",
          "legendFormat": "{{ iface }} RX drops"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "pps" } }
    }
  ]
}
